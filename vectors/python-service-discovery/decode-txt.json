{
  "$schema": "https://ebus.energy/schemas/conformance-vectors.json",
  "suite": "python-service-discovery/decode-txt",
  "version": "0.1",
  "generator": "rust-sdk tools/gen_vectors.py from python-service-discovery 0.5.1",
  "cases": [
    {
      "id": "decode-txt-simple",
      "source": "python-service-discovery:ebus.py decode_txt over python-zeroconf's TXT parse",
      "input": {
        "strings": [
          "txtvers=1",
          "roles=device,controller"
        ]
      },
      "expect": {
        "txt": [
          [
            "txtvers",
            "1"
          ],
          [
            "roles",
            "device,controller"
          ]
        ]
      }
    },
    {
